<html lang='fr'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{subject}}</title>
  </head>
  <body
    style="margin:0;padding:0;background-color:#0a0a10;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;"
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background-color:#0a0a10;padding:40px 16px;'
    >
      <tr>
        <td align='center'>
          <table role='presentation' width='560' cellpadding='0' cellspacing='0' style='max-width:560px;width:100%;'>

            <!-- Header -->
            <tr>
              <td style='padding-bottom:32px;'>
                <table role='presentation' cellpadding='0' cellspacing='0'>
                  <tr>
                    <td
                      style="background:linear-gradient(135deg,hsl(245,58%,61%),hsl(280,60%,55%));width:36px;height:36px;border-radius:10px;text-align:center;vertical-align:middle;font-size:18px;color:#ffffff;font-weight:500;font-family:'Courier New',Courier,monospace;line-height:36px;"
                    >{{logo}}</td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Card -->
            <tr>
              <td
                style='background-color:hsl(240,14%,6%);border:1px solid hsl(240,10%,14%);border-radius:12px;padding:0;overflow:hidden;'
              >

                <!-- Accent bar -->
                <div
                  style='height:3px;background:linear-gradient(90deg,hsl(245,58%,61%),hsl(280,60%,55%),hsl(245,58%,61%));'
                ></div>

                <!-- Content -->
                <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='padding:32px;'>
                  <tr>
                    <td>
                      <!-- Badge -->
                      <table role='presentation' cellpadding='0' cellspacing='0' style='margin-bottom:24px;'>
                        <tr>
                          <td
                            style='background-color:hsl(245,58%,61%,0.12);border:1px solid hsl(245,58%,61%,0.2);border-radius:20px;padding:5px 14px;'
                          >
                            <span style='color:hsl(245,58%,80%);font-size:12px;font-weight:500;'>Nouveau message</span>
                          </td>
                        </tr>
                      </table>

                      <!-- Subject -->
                      <h1
                        style='margin:0 0 24px;color:hsl(240,10%,93%);font-size:22px;font-weight:700;letter-spacing:-0.03em;line-height:1.3;'
                      >
                        {{subject}}
                      </h1>

                      <!-- Sender info -->
                      <table
                        role='presentation'
                        width='100%'
                        cellpadding='0'
                        cellspacing='0'
                        style='background-color:hsl(240,12%,8%);border:1px solid hsl(240,10%,12%);border-radius:8px;padding:16px;margin-bottom:24px;'
                      >
                        <tr>
                          <td>
                            <table role='presentation' cellpadding='0' cellspacing='0' style='margin-bottom:10px;'>
                              <tr>
                                <td
                                  style='color:hsl(240,5%,50%);font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:0.08em;padding-right:12px;width:50px;'
                                >De</td>
                                <td style='color:hsl(240,10%,93%);font-size:14px;font-weight:500;'>{{name}}</td>
                              </tr>
                            </table>
                            <table role='presentation' cellpadding='0' cellspacing='0' style='margin-bottom:10px;'>
                              <tr>
                                <td
                                  style='color:hsl(240,5%,50%);font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:0.08em;padding-right:12px;width:50px;'
                                >Email</td>
                                <td>
                                  <a
                                    href='mailto:{{email}}'
                                    style='color:hsl(245,58%,70%);font-size:14px;text-decoration:none;'
                                  >{{email}}</a>
                                </td>
                              </tr>
                            </table>
                            <table role='presentation' cellpadding='0' cellspacing='0'>
                              <tr>
                                <td
                                  style='color:hsl(240,5%,50%);font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:0.08em;padding-right:12px;width:50px;'
                                >Date</td>
                                <td style='color:hsl(240,5%,50%);font-size:13px;'>{{date}}</td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                      </table>

                      <!-- Divider -->
                      <div style='height:1px;background-color:hsl(240,10%,12%);margin-bottom:24px;'></div>

                      <!-- Message -->
                      <p
                        style='margin:0;color:hsl(240,10%,80%);font-size:15px;line-height:1.7;white-space:pre-wrap;'
                      >{{message}}</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Reply CTA -->
            <tr>
              <td style='padding-top:24px;' align='center'>
                <a
                  href='mailto:{{email}}?subject=Re: {{subject}}'
                  style='display:inline-block;background:hsl(245,58%,61%);color:#ffffff;font-size:13px;font-weight:600;padding:10px 24px;border-radius:8px;text-decoration:none;letter-spacing:-0.01em;'
                >
                  Répondre à
                  {{name}}
                </a>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style='padding-top:32px;text-align:center;'>
                <p style='margin:0;color:hsl(240,5%,35%);font-size:12px;line-height:1.6;'>
                  Ce message a été envoyé depuis le formulaire de contact<br />de votre portfolio
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>