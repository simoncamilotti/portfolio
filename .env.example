# Time zone for the Node server. Should always be UTC.
TZ=Etc/UTC

# LOCAL SERVICES (docker-compose.yml)

## PostgreSQL. The first start also creates the `keycloak` and `<POSTGRES_DB>_e2e` databases.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
POSTGRES_PORT=5433

## Keycloak (admin console: admin / admin). The `portfolio` realm is imported from
## docker/keycloak/realm.json on the first start.
KEYCLOAK_PORT=8081

## Mailpit (SMTP and web UI)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# API

## Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/portfolio?schema=public"

## Auth
KEYCLOAK_CLIENT_ID=portfolio-client
KEYCLOAK_ISSUER_URL="http://localhost:8081/realms/portfolio"

## Auth e2e tests (user of the imported realm)
KEYCLOAK_TEST_USER=test-e2e
KEYCLOAK_TEST_PASSWORD=<replace_me>

## Contact form
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<replace_me>
SMTP_PASS=<replace_me>
SMTP_FROM=<replace_me>
CONTACT_EMAIL_TO=<replace_me>

## reCAPTCHA
RECAPTCHA_SECRET_KEY=<replace_me>
