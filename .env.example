# Time zone for the Node server. Should always be UTC.
TZ=Etc/UTC

# LOCAL SERVICES (docker-compose.yml)

## PostgreSQL. The first start also creates the `keycloak` and `<POSTGRES_DB>_e2e` databases.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
POSTGRES_PORT=5433

## Keycloak (admin console: admin / admin). The `portfolio` realm is imported from
## docker/keycloak/realm.json on the first start.
KEYCLOAK_PORT=8081

## Mailpit (SMTP and web UI)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# API

## Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/portfolio?schema=public"

## Server
PORT=3000
LOG_LEVEL=info
# Origins allowed to call the API from a browser, comma-separated. Required in production.
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

## Auth
# OIDC issuer: its keys are found by discovery.
OIDC_ISSUER_URL=http://localhost:8081/realms/portfolio
# Expected `aud` claim of the access tokens (audience mapper of the client in the realm).
OIDC_AUDIENCE=portfolio-client

## OpenTelemetry (optional): traces and metrics are exported only when the endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=portfolio-api

## Auth e2e tests (user of the imported realm)
KEYCLOAK_TEST_USER=test-e2e
KEYCLOAK_TEST_PASSWORD=<replace_me>

## Contact form (local Mailpit by default; port 465 uses implicit TLS)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=portfolio@localhost
CONTACT_EMAIL_TO=me@localhost

## reCAPTCHA
RECAPTCHA_SECRET_KEY=<replace_me>
