{
  "name": "core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/core/src",
  "projectType": "library",
  "tags": ["type:lib", "platform:node"],
  "// targets": "to see all targets run: nx show project core --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "parallel": false
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/src/prisma/schema.prisma", "{workspaceRoot}/prisma.config.ts"],
      "outputs": ["{workspaceRoot}/node_modules/.prisma"],
      "options": {
        "command": "prisma generate",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
