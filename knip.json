{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["prisma"],
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "eslint-plugin-import",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "typescript-eslint"
      ]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/instrumentation.ts", "src/generate-openapi.ts"],
      "ignoreDependencies": ["pino-pretty", "handlebars", "nodemailer"]
    },
    "apps/client": {
      "entry": ["src/main.tsx", "src/styles.css"],
      "ignore": ["types/window.d.ts"]
    },
    "apps/studio": {
      "entry": ["src/main.tsx", "src/styles.css"],
      "ignore": ["src/app/modules/ui/**"]
    },
    "apps/client-e2e": {
      "entry": ["playwright.config.ts", "src/**/*.ts"]
    },
    "apps/studio-e2e": {
      "entry": ["playwright.config.ts", "src/**/*.ts"]
    },
    "libs/shared/api-client": {
      "entry": ["scripts/index-mocks.mjs"],
      "ignoreDependencies": ["@tanstack/react-query", "@faker-js/faker", "msw"]
    },
    "apps/api-e2e": {
      "entry": ["vitest.e2e.config.ts", "src/**/*.ts"]
    }
  },
  "ignore": ["apps/api/src/generated/**"],
  "rules": {
    "duplicates": "off"
  }
}
