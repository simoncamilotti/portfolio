{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/api/src/main.ts",
    "apps/client/src/main.tsx",
    "apps/studio/src/main.tsx",
    "libs/*/src/index.ts",
    "libs/*/*/src/index.ts",
    "**/*.spec.{ts,tsx}",
    "**/vitest.config.ts",
    "**/playwright.config.ts",
    "**/test-setup.ts",
    "**/support/global-setup.ts"
  ],
  "project": ["apps/**/*.{ts,tsx}", "libs/**/*.{ts,tsx}", "*.ts"],
  "ignore": [
    "apps/client/types/window.d.ts",
    "apps/studio/types/window.d.ts",
    "apps/studio/src/app/modules/ui/**"
  ],
  "ignoreDependencies": [
    "eslint-plugin-import",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-playwright",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "typescript-eslint",
    "pino-pretty",
    "@vitejs/plugin-react",
    "autoprefixer",
    "postcss",
    "tailwindcss",
    "@nx/react"
  ],
  "ignoreUnresolved": ["^\\*$"],
  "rules": {
    "duplicates": "off"
  }
}
