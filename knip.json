{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["prisma"],
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "eslint-plugin-import",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "typescript-eslint"
      ]
    },
    "apps/api": {
      "entry": ["src/main.ts"],
      "ignoreDependencies": ["pino-pretty", "handlebars", "nodemailer"]
    },
    "apps/client": {
      "entry": ["src/main.tsx", "src/styles.css"],
      "ignore": ["types/window.d.ts"]
    },
    "apps/studio": {
      "entry": ["src/main.tsx", "src/styles.css"],
      "ignore": ["types/window.d.ts", "src/app/modules/ui/**"]
    },
    "apps/client-e2e": {
      "entry": ["playwright.config.ts", "src/**/*.ts"]
    },
    "apps/studio-e2e": {
      "entry": ["playwright.config.ts", "src/**/*.ts"]
    },
    "apps/api-e2e": {
      "entry": ["vitest.e2e.config.ts", "src/**/*.ts"]
    }
  },
  "ignore": ["apps/api/src/generated/**", "config/**"],
  "rules": {
    "duplicates": "off"
  }
}
