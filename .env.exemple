# Time zone for the Node server. Should always be UTC.
TZ=Etc/UTC

# INFRASTRUCTURE

## DATABASE (replace values in prod)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=portfolio

## KEYCLOAK
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# APP  (replace values in prod)

## DATABSE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"

## AUTH
KEYCLOAK_CLIENT_ID=portfolio-client
KEYCLOAK_CLIENT_SECRET=<replace_me> # Get from Credentials tab in portfolio-client keycloak client.
KEYCLOAK_ISSUER_URL="http://localhost:8080/realms/portfolio"

## AUTH E2E TESTS (Keycloak test user credentials)
KEYCLOAK_TEST_USER=<replace_me>
KEYCLOAK_TEST_PASSWORD=<replace_me>

## CONTACT FORM
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<replace_me>
SMTP_PASS=<replace_me>
SMTP_FROM=<replace_me>
CONTACT_EMAIL_TO=<replace_me>

## RECAPTCHA
RECAPTCHA_SECRET_KEY=<replace_me>
